---
/**
 * Sticky navbar with blur, section links, language switcher, and a polished
 * mobile menu. Each language has its own pages (/, /fr/, /ar/), so the
 * switcher links to the same page in the other language (`path` is the
 * current page's language-free path, e.g. "/events/").
 */
import {t, localePath} from '../i18n/utils.js'
import {languages} from '../i18n/ui.js'
import Icon from './Icon.astro'

const {lang = 'en', path = '/'} = Astro.props
const home = localePath(lang, '/')
const sections = [
  ['home', 'nav.home'], ['about', 'nav.about'], ['legacy', 'nav.legacy'], ['impact', 'nav.impact'],
  ['work', 'nav.work'], ['team', 'nav.team'], ['join', 'nav.join'],
]
const langLinks = languages.map((l) => ({l, href: localePath(l, path), active: l === lang}))
---

<nav class="fixed top-0 left-0 right-0 z-50 nav-blur bg-white/80 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-6 h-16 lg:h-20">
      <a href={`${home}#home`} class="flex items-center shrink-0">
        <img src="/images/logo.png" alt="JCI El Alia" class="h-12 lg:h-14 w-auto" />
      </a>

      <!-- Desktop links -->
      <div class="hidden xl:flex items-center gap-4 whitespace-nowrap">
        {sections.map(([id, key]) => (
          <a href={`${home}#${id}`} class="nav-link text-sm font-medium text-jci-black/70 hover:text-jci-blue transition-colors">{t(key, lang)}</a>
        ))}
      </div>

      <div class="hidden xl:flex items-center gap-3 whitespace-nowrap shrink-0">
        <div class="lang-switch flex items-center gap-1 bg-gray-100 rounded-full p-1">
          {langLinks.map(({l, href, active}) => (
            <a href={href} hreflang={l} lang={l} data-lang={l} aria-current={active ? 'true' : undefined} class:list={['lang-btn px-3 py-1 text-xs font-semibold rounded-full transition-all duration-300 uppercase', active ? 'bg-white text-jci-black shadow-sm' : 'text-jci-black/60 hover:text-jci-black']}>{l}</a>
          ))}
        </div>
        <a href={`${home}#join`} class="bg-jci-blue text-white px-5 py-2.5 rounded-full text-sm font-semibold hover:bg-jci-navy transition-colors">{t('nav.cta', lang)}</a>
      </div>

      <button id="mobile-menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu" class="xl:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors">
        <Icon name="fa-bars" class="menu-open text-xl text-jci-black" />
        <Icon name="fa-times" class="menu-close hidden text-xl text-jci-black" />
      </button>
    </div>
  </div>

  <!-- Mobile menu (animated max-height) -->
  <div id="mobile-menu" class="xl:hidden overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out bg-white border-t border-gray-100">
    <div class="px-4 py-4 space-y-1">
      {sections.map(([id, key]) => (
        <a href={`${home}#${id}`} class="block py-2.5 text-sm font-medium text-jci-black/70 hover:text-jci-blue transition-colors">{t(key, lang)}</a>
      ))}
      <div class="lang-switch flex items-center gap-2 pt-3">
        {langLinks.map(({l, href, active}) => (
          <a href={href} hreflang={l} lang={l} data-lang={l} aria-current={active ? 'true' : undefined} class:list={['lang-btn px-3 py-1.5 text-xs font-semibold rounded-full transition-all duration-300 uppercase', active ? 'bg-jci-blue/10 text-jci-blue' : 'text-jci-black/60']}>{l}</a>
        ))}
      </div>
      <a href={`${home}#join`} class="block bg-jci-blue text-white text-center px-5 py-2.5 rounded-full text-sm font-semibold mt-3">{t('nav.cta', lang)}</a>
    </div>
  </div>
</nav>
