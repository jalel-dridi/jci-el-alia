---
/**
 * All client-side behavior in one place:
 *  - remembering the chosen language (pages are per-language: /, /fr/, /ar/)
 *  - animated stat counters on scroll into view
 *  - navbar states: see-through over the hero, solid once scrolled, hidden
 *    while scrolling down (see .site-nav in global.css)
 *  - active nav link highlighting + back-to-top
 *  - polished mobile menu (animated max-height)
 * Entrance/scroll animations live in src/scripts/motion.js (GSAP).
 */
---

<script is:inline>
  (function () {
    // ---- Language switcher: remember the choice for the next visit ----
    document.querySelectorAll('.lang-btn').forEach((a) => {
      a.addEventListener('click', () => {
        try { localStorage.setItem('jci-lang', a.getAttribute('data-lang')) } catch (e) {}
      })
    })

    // ---- Mobile menu (animated) ----
    const menuBtn = document.getElementById('mobile-menu-btn')
    const mobileMenu = document.getElementById('mobile-menu')
    const nav = document.querySelector('.site-nav')
    function closeMenu() {
      mobileMenu.style.maxHeight = '0px'
      setMenuIcon(false)
    }
    function setMenuIcon(open) {
      nav.classList.toggle('menu-open', open)
      menuBtn.setAttribute('aria-expanded', String(open))
      menuBtn.querySelector('.menu-open').classList.toggle('hidden', open)
      menuBtn.querySelector('.menu-close').classList.toggle('hidden', !open)
    }
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', () => {
        const open = mobileMenu.style.maxHeight && mobileMenu.style.maxHeight !== '0px'
        if (open) { closeMenu() }
        else {
          mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px'
          setMenuIcon(true)
        }
      })
      mobileMenu.querySelectorAll('a[href*="#"]').forEach((l) => l.addEventListener('click', closeMenu))
    }

    // ---- Counters ----
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    function animateCounter(el) {
      const target = parseInt(el.getAttribute('data-target'), 10) || 0
      if (reduceMotion) { el.textContent = target.toString(); return }
      const dur = 1600, start = performance.now()
      function step(now) {
        const p = Math.min((now - start) / dur, 1)
        const eased = 1 - Math.pow(1 - p, 3)
        el.textContent = Math.round(eased * target).toString()
        if (p < 1) requestAnimationFrame(step)
      }
      requestAnimationFrame(step)
    }
    const counterObs = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { animateCounter(e.target); counterObs.unobserve(e.target) } })
    }, { threshold: 0.5 })
    document.querySelectorAll('.counter').forEach((el) => counterObs.observe(el))

    // ---- Active nav + back to top ----
    const sects = document.querySelectorAll('section[id]')
    const navLks = document.querySelectorAll('.nav-link')
    const backTop = document.getElementById('back-to-top')
    if (backTop) backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))
    const overlay = nav.hasAttribute('data-overlay')
    let lastY = window.scrollY
    function updateNav() {
      const y = window.scrollY
      nav.classList.toggle('is-scrolled', y > 40)
      if (overlay) nav.classList.toggle('is-overlay', y <= 40)
      // Slide away while reading down; come back on any upward scroll.
      const menuOpen = nav.classList.contains('menu-open')
      if (y > 400 && y > lastY + 4 && !menuOpen) nav.classList.add('is-hidden')
      else if (y < lastY - 4 || y <= 400) nav.classList.remove('is-hidden')
      lastY = y
    }
    updateNav()
    window.addEventListener('scroll', () => {
      updateNav()
      let cur = ''
      sects.forEach((s) => { if (window.scrollY >= s.offsetTop - 100) cur = s.id })
      navLks.forEach((l) => l.classList.toggle('active', l.getAttribute('href').endsWith('#' + cur)))
      if (backTop) backTop.classList.toggle('visible', window.scrollY > 600)
    })
  })()
</script>
