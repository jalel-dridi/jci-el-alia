---
/**
 * Join Us — benefits list + Formspree intake form.
 * Set FORMSPREE_ID to the form's ID (formspree.io/f/<ID>). Until then, the form
 * opens the visitor's email app pre-filled to the chapter's address, so
 * applications are never lost.
 */
import {t} from '../i18n/utils.js'
import Icon from './Icon.astro'

const FORMSPREE_ID = ''
const {settings = {}, lang = 'en'} = Astro.props
const labelClass = 'block text-white/80 text-sm mb-1.5'
// 16px on phones: iOS zooms the page into anything smaller.
const fieldClass = 'w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white text-base sm:text-sm focus:outline-none focus:border-jci-teal transition-colors'
const action = FORMSPREE_ID ? `https://formspree.io/f/${FORMSPREE_ID}` : undefined
const mailto = `mailto:${settings.email || 'jcielalia@gmail.com'}`
---

<section id="join" class="py-24 lg:py-32 bg-gradient-to-br from-jci-black via-jci-navy to-jci-blue relative overflow-hidden">
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] border border-white/[0.05] rounded-full -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] border border-white/[0.05] rounded-full translate-y-1/2 -translate-x-1/3"></div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="reveal">
        <p class="text-jci-teal-light font-semibold text-sm uppercase tracking-wider mb-4">{t('join.label', lang)}</p>
        <h2 class="text-3xl lg:text-4xl font-light text-white leading-[1.3] mb-6">{t('join.title', lang)}</h2>
        <p class="text-base text-white/80 leading-[1.8] mb-8">{t('join.desc', lang)}</p>
        <ul class="space-y-4 mb-8">
          {['join.b1', 'join.b2', 'join.b3', 'join.b4'].map((k) => (
            <li class="flex items-center gap-3">
              <div class="w-6 h-6 bg-jci-teal/20 rounded-full flex items-center justify-center flex-shrink-0"><Icon name="fa-check" class="text-jci-teal text-xs" /></div>
              <span class="text-white/80 text-sm">{t(k, lang)}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal">
        <div class="bg-white/10 backdrop-blur-md rounded-3xl p-8 border border-white/20">
          <h3 class="text-xl font-semibold text-white mb-6">{t('join.formtitle', lang)}</h3>
          <form id="join-form" action={action} data-mailto={action ? undefined : mailto} method="POST" class="space-y-4">
            <label class="block">
              <span class={labelClass}>{t('join.ph1', lang)}</span>
              <input type="text" name="name" required autocomplete="name" class={fieldClass} />
            </label>
            <label class="block">
              <span class={labelClass}>{t('join.ph2', lang)}</span>
              <input type="email" name="email" required autocomplete="email" dir="ltr" class={fieldClass} />
            </label>
            <label class="block">
              <span class={labelClass}>{t('join.ph3', lang)}</span>
              <input type="tel" name="phone" autocomplete="tel" dir="ltr" class={fieldClass} />
            </label>
            <label class="block">
              <span class={labelClass}>{t('join.ph4', lang)}</span>
              <textarea name="message" rows="3" class={`${fieldClass} resize-none`}></textarea>
            </label>
            <button type="submit" class="w-full bg-white hover:bg-jci-teal text-jci-navy hover:text-jci-black py-3.5 rounded-xl font-semibold text-sm transition-colors disabled:opacity-60">{t('join.submit', lang)}</button>
            <p id="join-success" class="hidden text-jci-teal-light text-sm text-center">{t('join.success', lang)}</p>
            <p id="join-mailto" class="hidden text-jci-teal-light text-sm text-center">{t('join.mailto', lang)}</p>
            <p id="join-error" class="hidden text-red-300 text-sm text-center">{t('join.error', lang)}</p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const form = document.getElementById('join-form')
    if (!form) return
    const ok = document.getElementById('join-success')
    const err = document.getElementById('join-error')
    const btn = form.querySelector('button[type="submit"]')
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      // No Formspree ID yet: hand the application to the visitor's email app.
      if (form.dataset.mailto) {
        const d = new FormData(form)
        const body = ['Name: ' + d.get('name'), 'Email: ' + d.get('email'), 'Phone: ' + (d.get('phone') || '-'), '', d.get('message') || ''].join('\n')
        location.href = form.dataset.mailto + '?subject=' + encodeURIComponent('Membership application - ' + d.get('name')) + '&body=' + encodeURIComponent(body)
        document.getElementById('join-mailto').classList.remove('hidden')
        return
      }
      ok.classList.add('hidden'); err.classList.add('hidden')
      btn.disabled = true
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {Accept: 'application/json'},
        })
        if (res.ok) { form.reset(); ok.classList.remove('hidden') }
        else { err.classList.remove('hidden') }
      } catch (_) {
        err.classList.remove('hidden')
      } finally {
        btn.disabled = false
      }
    })
  })()
</script>
