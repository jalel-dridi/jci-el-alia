---
/**
 * Our Work — the yearly showcase of events with photo albums.
 * The latest events, newest first, each linking to its album page at
 * /events/[slug]. Shows a friendly empty-state when no events exist
 * yet (before the CMS is populated). Only the latest few are shown here; the
 * full archive lives at /events.
 */
import {t, localePath} from '../i18n/utils.js'
import EventCard from './EventCard.astro'
import Icon from './Icon.astro'

const HOMEPAGE_LIMIT = 6
const {events = [], lang = 'en'} = Astro.props
const latest = [...events]
  .sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')))
  .slice(0, HOMEPAGE_LIMIT)
---

<section id="work" class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <p class="text-jci-blue-ink font-semibold text-sm uppercase tracking-wider mb-4">{t('work.label', lang)}</p>
      <h2 class="text-3xl lg:text-4xl font-light text-jci-black mb-4">{t('work.title', lang)}</h2>
      <p class="text-jci-black/60 max-w-2xl mx-auto">{t('work.intro', lang)}</p>
    </div>

    {events.length === 0 ? (
      <div class="text-center py-16 border-2 border-dashed border-gray-200 rounded-3xl">
        <Icon name="fa-images" class="text-gray-300 text-5xl mb-4" />
        <p class="text-jci-black/60">Events and photo albums will appear here once added in the dashboard.</p>
      </div>
    ) : (
      <div class="swipe-row grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12 reveal">
        {latest.map((ev) => <EventCard ev={ev} lang={lang} />)}
      </div>
    )}

    {events.length > 0 && (
      <div class="text-center mt-4">
        <a href={localePath(lang, "/events/")} class="inline-flex items-center gap-2 text-jci-blue-ink font-semibold hover:text-jci-navy transition-colors">
          <span>{t('work.viewall', lang)}</span>
          <Icon name="fa-arrow-right" class="rtl:rotate-180" />
        </a>
      </div>
    )}
  </div>
</section>
