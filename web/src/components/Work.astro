---
/**
 * Our Work — the yearly showcase of events with photo albums.
 * Events are grouped by year (newest first). Each card links to its album
 * page at /events/[slug]. Shows a friendly empty-state when no events exist
 * yet (before the CMS is populated). Only the latest few are shown here; the
 * full archive lives at /events.
 */
import {t} from '../i18n/utils.js'
import EventCard from './EventCard.astro'

const HOMEPAGE_LIMIT = 6
const {events = [], lang = 'en'} = Astro.props
const latest = [...events]
  .sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')))
  .slice(0, HOMEPAGE_LIMIT)

// Group by year, newest first
const byYear = {}
for (const ev of latest) {
  const y = ev.year || (ev.date ? new Date(ev.date).getFullYear() : 0)
  ;(byYear[y] ||= []).push(ev)
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a)
---

<section id="work" class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <p class="text-jci-blue font-semibold text-sm uppercase tracking-wider mb-4" data-i18n="work.label">{t('work.label', lang)}</p>
      <h2 class="text-3xl lg:text-4xl font-light text-jci-black mb-4" data-i18n="work.title">{t('work.title', lang)}</h2>
      <p class="text-jci-black/50 max-w-2xl mx-auto" data-i18n="work.intro">{t('work.intro', lang)}</p>
    </div>

    {events.length === 0 ? (
      <div class="text-center py-16 border-2 border-dashed border-gray-200 rounded-3xl">
        <i class="fas fa-images text-gray-300 text-5xl mb-4"></i>
        <p class="text-jci-black/40">Events and photo albums will appear here once added in the dashboard.</p>
      </div>
    ) : (
      years.map((year) => (
        <div class="mb-16 reveal">
          <div class="flex items-center gap-4 mb-8">
            <span class="text-2xl font-bold text-jci-blue">{year}</span>
            <div class="flex-1 h-px bg-gray-200"></div>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {byYear[year].map((ev) => <EventCard ev={ev} lang={lang} />)}
          </div>
        </div>
      ))
    )}

    {events.length > 0 && (
      <div class="text-center mt-4">
        <a href="/events" class="inline-flex items-center gap-2 text-jci-blue font-semibold hover:text-jci-navy transition-colors">
          <span data-i18n="work.viewall">{t('work.viewall', lang)}</span>
          <i class="fas fa-arrow-right rtl:rotate-180"></i>
        </a>
      </div>
    )}
  </div>
</section>
