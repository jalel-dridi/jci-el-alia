---
/**
 * Footer — chapter info, quick links, social/contact. Data-driven contact.
 */
import {t, localePath} from '../i18n/utils.js'
import Icon from './Icon.astro'
const {settings, lang = 'en'} = Astro.props
const year = new Date().getFullYear()
---

<footer class="bg-jci-black text-white pt-16 pb-24 sm:pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-3 gap-12 mb-12">
      <div>
        <img src="/images/logo-nav-inverted.png" alt="JCI El Alia" width="240" height="112" loading="lazy" class="h-11 w-auto mb-4" />
        <p class="text-white/70 text-sm leading-relaxed mb-4">{t('footer.desc', lang)}</p>
        <div class="flex items-center gap-2 text-white/60 text-sm">
          <Icon name="fa-map-marker-alt" />
          <span>{settings.address}</span>
        </div>
      </div>
      <div>
        <h4 class="font-semibold text-white mb-4">{t('footer.links', lang)}</h4>
        <ul class="space-y-1">
          <li><a href={`${localePath(lang, "/")}#home`} class="text-white/70 hover:text-jci-teal text-sm transition-colors inline-block py-1">{t('nav.home', lang)}</a></li>
          <li><a href={`${localePath(lang, "/")}#about`} class="text-white/70 hover:text-jci-teal text-sm transition-colors inline-block py-1">{t('nav.about', lang)}</a></li>
          <li><a href={`${localePath(lang, "/")}#legacy`} class="text-white/70 hover:text-jci-teal text-sm transition-colors inline-block py-1">{t('nav.legacy', lang)}</a></li>
          <li><a href={`${localePath(lang, "/")}#impact`} class="text-white/70 hover:text-jci-teal text-sm transition-colors inline-block py-1">{t('nav.impact', lang)}</a></li>
          <li><a href={`${localePath(lang, "/")}#work`} class="text-white/70 hover:text-jci-teal text-sm transition-colors inline-block py-1">{t('nav.work', lang)}</a></li>
          <li><a href="https://jci.cc" target="_blank" rel="noopener" class="text-white/70 hover:text-jci-teal text-sm transition-colors inline-block py-1">JCI International</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-white mb-4">{t('footer.connect', lang)}</h4>
        <div class="flex items-center gap-4 mb-6">
          {settings.facebook && <a href={settings.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-jci-blue-ink transition-colors"><Icon name="fa-facebook-f" class="text-white text-sm" /></a>}
          {settings.instagram && <a href={settings.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-jci-blue-ink transition-colors"><Icon name="fa-instagram" class="text-white text-sm" /></a>}
          {settings.linkedin && <a href={settings.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-jci-blue-ink transition-colors"><Icon name="fa-linkedin-in" class="text-white text-sm" /></a>}
        </div>
        <div class="space-y-2 text-sm text-white/70">
          {settings.email && <div class="flex items-center gap-2"><Icon name="fa-envelope" class="text-xs" /><a href={`mailto:${settings.email}`} class="hover:text-jci-teal transition-colors">{settings.email}</a></div>}
          {settings.phone && <div class="flex items-center gap-2"><Icon name="fa-phone" class="text-xs" /><a href={`tel:${settings.phone.replace(/\s+/g, '')}`} dir="ltr" class="hover:text-jci-teal transition-colors">{settings.phone}</a></div>}
        </div>
      </div>
    </div>
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 sm:pe-16">
      <p class="text-white/60 text-sm">&copy; {year} JCI El Alia. {t('footer.rights', lang)}</p>
      <p class="text-white/60 text-sm">{t('footer.affiliation', lang)}</p>
    </div>
  </div>
</footer>

<button id="back-to-top" aria-label={t('a11y.top', lang)} class="fixed bottom-6 right-6 rtl:right-auto rtl:left-6 z-40 w-12 h-12 bg-jci-blue-ink text-white rounded-full shadow-lg flex items-center justify-center hover:bg-jci-navy transition-colors">
  <Icon name="fa-arrow-up" class="text-sm" />
</button>
