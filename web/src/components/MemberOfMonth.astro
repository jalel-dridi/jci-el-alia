---
/**
 * Member of the Month — spotlight on the latest entry from the dashboard,
 * shown just above the team. Renders nothing until one is published.
 */
import {t, formatDate} from '../i18n/utils.js'
import {pick, urlFor} from '../lib/sanity.js'
import {initials} from '../lib/people.js'

const {member, lang = 'en'} = Astro.props
const photo = member?.photo ? urlFor(member.photo).width(240).height(240).fit('crop').url() : null
---

{member && (
  <section class="pt-20 lg:pt-28 pb-4" aria-labelledby="mom-name">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="reveal flex flex-col sm:flex-row items-center gap-6 sm:gap-8 rounded-3xl bg-gradient-to-br from-jci-blue/5 to-jci-teal/10 border border-gray-100 p-6 sm:p-8 text-center sm:text-start">
        {photo ? (
          <img src={photo} alt={member.name} width="240" height="240" loading="lazy" class="w-28 h-28 rounded-full object-cover ring-4 ring-white shadow-md shrink-0" />
        ) : (
          <div class="w-28 h-28 rounded-full bg-jci-yellow/20 text-jci-yellow-ink text-3xl font-bold flex items-center justify-center ring-4 ring-white shrink-0">{initials(member.name)}</div>
        )}
        <div>
          <p class="text-jci-blue-ink font-semibold text-sm uppercase tracking-wider mb-2">
            {t('mom.label', lang)} · <time datetime={member.month}>{formatDate(member.month, lang, {month: 'long', year: 'numeric'})}</time>
          </p>
          <h2 id="mom-name" class="text-2xl lg:text-3xl font-light text-jci-black mb-2">{member.name}</h2>
          {pick(member.note, lang) && <p class="text-jci-black/70 leading-relaxed">{pick(member.note, lang)}</p>}
        </div>
      </div>
    </div>
  </section>
)}
