---
/**
 * Testimonial / Quote — a legacy quote set in the brand quote typeface (Arvo).
 * Ties into the "Honor The Legacy" theme.
 */
import {t} from '../i18n/utils.js'
import {pick, urlFor} from '../lib/sanity.js'
import Icon from './Icon.astro'

const {testimonial, presidents = [], lang = 'en'} = Astro.props
const speaker = presidents.find((p) => p.name === testimonial.author && p.photo)
const photo = speaker ? urlFor(speaker.photo).width(96).height(96).fit('crop').url() : null
---

<section class="py-24 lg:py-32 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
    <p class="text-jci-blue-ink font-semibold text-sm uppercase tracking-wider mb-8">{t('quote.label', lang)}</p>
    <Icon name="fa-quote-left" class="text-jci-teal/30 text-5xl mb-6" />
    <blockquote class="font-arvo text-2xl sm:text-3xl text-jci-black leading-[1.5] mb-8">
      {pick(testimonial.quote, lang)}
    </blockquote>
    <div class="flex items-center justify-center gap-4">
      {photo ? (
        <img src={photo} alt="" width="48" height="48" loading="lazy" class="w-12 h-12 rounded-full object-cover" />
      ) : (
        <div class="w-12 h-12 rounded-full bg-jci-blue/10 flex items-center justify-center">
          <Icon name="fa-user" class="text-jci-blue-ink" />
        </div>
      )}
      <div class="text-left rtl:text-right">
        <div class="font-semibold text-jci-black">{testimonial.author}</div>
        <div class="text-sm text-jci-black/60">{pick(testimonial.role, lang)}</div>
      </div>
    </div>
  </div>
</section>
