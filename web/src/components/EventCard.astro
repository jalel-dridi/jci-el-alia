---
/**
 * Event card — cover, photo count, category, title, summary, and a link to the
 * album page. Shared by the homepage "Our Work" section and the /events archive.
 * Rendered in the page's language; links stay within that language.
 */
import {t, localePath, formatDate} from '../i18n/utils.js'
import {pick, eventCover, eventCoverSrcset, eventGallery} from '../lib/sanity.js'
import Icon from './Icon.astro'

const {ev, lang = 'en'} = Astro.props
const cover = eventCover(ev, 800, 500)
const coverSrcset = eventCoverSrcset(ev, [400, 800], 5 / 8)
const count = eventGallery(ev).length
const catKey = `cat.${ev.category}`
---

<a href={localePath(lang, `/events/${ev.slug}/`)} class="card-hover group bg-white rounded-2xl overflow-hidden border border-gray-100 flex flex-col">
  <div class="h-52 overflow-hidden bg-gray-100 relative">
    {cover && <img src={cover} srcset={coverSrcset} sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, min(85vw, 320px)" alt={pick(ev.title, lang)} width="800" height="500" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" style={`view-transition-name: ev-${ev.slug}`} />}
    {count > 0 && (
      <span class="absolute top-3 right-3 rtl:right-auto rtl:left-3 bg-jci-black/70 text-white text-xs font-medium px-2.5 py-1 rounded-full backdrop-blur-sm">
        <Icon name="fa-camera" class="me-1" />{count} <span>{t('work.photos', lang)}</span>
      </span>
    )}
  </div>
  <div class="p-6 flex flex-col flex-1">
    <div class="flex items-center justify-between gap-3 mb-3">
      {ev.category && <span class="bg-jci-blue/10 text-jci-blue-ink text-xs font-semibold px-3 py-1 rounded-full capitalize">{t(catKey, lang)}</span>}
      {ev.date && <time datetime={ev.date} class="text-xs text-jci-black/60 whitespace-nowrap">{formatDate(ev.date, lang, {month: 'short', year: 'numeric'})}</time>}
    </div>
    <h3 class="text-lg font-semibold text-jci-black mb-2">{pick(ev.title, lang)}</h3>
    <p class="text-sm text-jci-black/60 leading-relaxed mb-4 line-clamp-2">{pick(ev.summary, lang)}</p>
    <span class="mt-auto inline-flex items-center gap-2 text-jci-teal-ink text-sm font-medium">
      <span>{t('work.viewalbum', lang)}</span>
      <Icon name="fa-arrow-right" class="rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform" />
    </span>
  </div>
</a>
