---
/**
 * Event card — cover, photo count, category, title, summary, and a link to the
 * album page. Shared by the homepage "Our Work" section and the /events archive.
 * Title/summary/category carry data-i18n keys so the language switcher covers them.
 */
import {t} from '../i18n/utils.js'
import {pick, eventCover, eventGallery} from '../lib/sanity.js'
import Icon from './Icon.astro'

const {ev, lang = 'en'} = Astro.props
const cover = eventCover(ev, 800, 500)
const count = eventGallery(ev).length
const catKey = `cat.${ev.category}`
---

<a href={`/events/${ev.slug}`} class="card-hover group bg-white rounded-2xl overflow-hidden border border-gray-100 block">
  <div class="h-52 overflow-hidden bg-gray-100 relative">
    {cover && <img src={cover} alt={pick(ev.title, lang)} width="800" height="500" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />}
    {count > 0 && (
      <span class="absolute top-3 right-3 rtl:right-auto rtl:left-3 bg-jci-black/70 text-white text-xs font-medium px-2.5 py-1 rounded-full backdrop-blur-sm">
        <Icon name="fa-camera" class="me-1" />{count} <span data-i18n="work.photos">{t('work.photos', lang)}</span>
      </span>
    )}
  </div>
  <div class="p-6">
    {ev.category && (
      <span class="inline-block bg-jci-blue/10 text-jci-blue text-xs font-semibold px-3 py-1 rounded-full mb-3 capitalize" data-i18n={catKey}>{t(catKey, lang)}</span>
    )}
    <h3 class="text-lg font-semibold text-jci-black mb-2" data-i18n={`ev.${ev.slug}.title`}>{pick(ev.title, lang)}</h3>
    <p class="text-sm text-jci-black/60 leading-relaxed mb-4 line-clamp-2" data-i18n={`ev.${ev.slug}.sum`}>{pick(ev.summary, lang)}</p>
    <span class="inline-flex items-center gap-2 text-jci-teal text-sm font-medium">
      <span data-i18n="work.viewalbum">{t('work.viewalbum', lang)}</span>
      <Icon name="fa-arrow-right" class="rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform" />
    </span>
  </div>
</a>
