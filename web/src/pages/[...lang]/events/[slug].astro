---
/**
 * Event album page — full description + photo gallery with a lightbox
 * (prev/next, arrow keys, swipe), share links, and the neighbouring events so
 * a visitor always has somewhere to go next. Emits schema.org Event data.
 * Static paths are generated from all events (CMS, with empty fallback).
 */
import Base from '../../../layouts/Base.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'
import SiteScripts from '../../../components/SiteScripts.astro'
import {getEvents, getSiteSettings} from '../../../lib/queries.js'
import * as seed from '../../../data/seed.js'
import {events as seedEvents} from '../../../data/events.js'
import {pick, eventCover, eventCoverSrcset, shareCover, eventGallery} from '../../../lib/sanity.js'
import {t, formatDate, localePath, langPaths} from '../../../i18n/utils.js'
import Icon from '../../../components/Icon.astro'

export async function getStaticPaths() {
  const events = await getEvents(seedEvents)
  const byDate = [...events].sort((a, b) => String(a.date || '').localeCompare(String(b.date || '')))
  return langPaths().flatMap(({params, props}) =>
    byDate.map((ev, i) => ({
      params: {...params, slug: ev.slug},
      props: {...props, event: ev, older: byDate[i - 1], newer: byDate[i + 1]},
    })),
  )
}

const {event, older, newer, lang} = Astro.props
const path = `/events/${event.slug}/`
const settings = await getSiteSettings(seed.siteSettings)

const cover = eventCover(event, 1600, 900)
const coverSrcset = eventCoverSrcset(event, [800, 1600], 9 / 16)
// 1200x630 is the size Facebook/WhatsApp/LinkedIn expect for link previews.
const shareImage = shareCover(event) || undefined
const gallery = eventGallery(event)
const dateStr = formatDate(event.date, lang)

const pageUrl = new URL(localePath(lang, path), Astro.site ?? 'https://jci-el-alia.pages.dev').href
const shareText = encodeURIComponent(`${pick(event.title, lang)} ${pageUrl}`)
const shareClass = 'inline-flex items-center gap-2 h-11 px-5 rounded-full border border-gray-200 text-sm font-medium text-jci-black/70 hover:border-jci-blue-ink hover:text-jci-blue-ink transition-colors'
const site = Astro.site ?? 'https://jci-el-alia.pages.dev'
// Home > Our Work > this album, shown by Google above the result.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {name: 'JCI El Alia', path: localePath(lang, '/')},
    {name: t('work.label', lang), path: localePath(lang, '/events/')},
    {name: pick(event.title, lang), path: localePath(lang, path)},
  ].map(({name, path: p}, i) => ({'@type': 'ListItem', position: i + 1, name, item: new URL(p, site).href})),
}
const neighbours = [
  older && {ev: older, label: t('event.prev', lang), icon: 'fa-arrow-left', side: '', align: ''},
  newer && {ev: newer, label: t('event.next', lang), icon: 'fa-arrow-right', side: 'sm:col-start-2 sm:flex-row-reverse sm:text-end', align: 'sm:justify-end'},
].filter(Boolean)

// schema.org Event — lets Google show date/place for the event in results.
const eventLd = event.date && {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: pick(event.title, lang),
  description: pick(event.summary, lang) || undefined,
  startDate: event.date,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: shareImage ? [new URL(shareImage, Astro.site ?? 'https://jci-el-alia.pages.dev').href] : undefined,
  location: {
    '@type': 'Place',
    name: event.location || 'El Alia',
    address: {'@type': 'PostalAddress', addressLocality: 'El Alia', addressRegion: 'Bizerte', addressCountry: 'TN'},
  },
  organizer: {'@type': 'Organization', name: 'JCI El Alia', url: Astro.site?.href ?? 'https://jci-el-alia.pages.dev'},
}
---

<Base
  lang={lang}
  path={path}
  title={`${pick(event.title, lang)} | JCI El Alia`}
  description={pick(event.summary, lang) || undefined}
  image={shareImage}
>
  {eventLd && <script type="application/ld+json" set:html={JSON.stringify(eventLd)} is:inline />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />
  <Navbar lang={lang} path={path} overlay />
  <main id="main">
    <!-- Hero / cover -->
    <div class="relative h-[60vh] min-h-[420px] bg-jci-black overflow-hidden" data-page-hero>
      {cover && <img src={cover} srcset={coverSrcset} sizes="100vw" alt={pick(event.title, lang)} data-hero-bg class="absolute inset-0 w-full h-full object-cover opacity-70" style={`view-transition-name: ev-${event.slug}`} />}
      <div class="absolute inset-0 bg-gradient-to-t from-jci-black via-jci-black/40 to-transparent"></div>
      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-end pb-10">
        <a href={`${localePath(lang, '/')}#work`} class="text-white/70 hover:text-white text-sm mb-4 inline-flex items-center gap-2 w-fit">
          <Icon name="fa-arrow-left" class="rtl:rotate-180" /><span>{t('work.back', lang)}</span>
        </a>
        <span class="inline-block bg-jci-blue-ink text-white text-xs font-semibold px-3 py-1 rounded-full mb-3 w-fit capitalize">{t(`cat.${event.category}`, lang)}</span>
        <h1 class="text-3xl lg:text-5xl font-light text-white">{pick(event.title, lang)}</h1>
        <div class="flex flex-wrap items-center gap-4 text-white/60 text-sm mt-3">
          {dateStr && <span><Icon name="fa-calendar" class="me-2" /><span>{dateStr}</span></span>}
          {event.location && <span><Icon name="fa-map-marker-alt" class="me-2" />{event.location}</span>}
        </div>
      </div>
    </div>

    <!-- Description -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <p class="text-lg text-jci-black/70 leading-[1.9] whitespace-pre-line">{pick(event.description, lang) || pick(event.summary, lang)}</p>
    </div>

    <!-- Gallery -->
    {gallery.length > 0 && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
        <div class="columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4">
          {gallery.map((img, i) => (
            <button class="gallery-item block w-full break-inside-avoid rounded-xl overflow-hidden group" data-full={img.full} aria-label={`${t('a11y.photo', lang)} ${i + 1} / ${gallery.length}: ${pick(event.title, lang)}`}>
              <img src={img.thumb} srcset={img.thumbSrcset} sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw" alt={img.alt || pick(event.title, lang)} loading="lazy" class="w-full group-hover:scale-105 transition-transform duration-500" />
            </button>
          ))}
        </div>
      </div>
    )}

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
      <!-- Share -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-16">
        <span class="w-full sm:w-auto text-center text-sm font-semibold text-jci-black/70 sm:me-2">{t('share.label', lang)}</span>
        <a href={`https://wa.me/?text=${shareText}`} target="_blank" rel="noopener" class={shareClass}><Icon name="fa-whatsapp" />WhatsApp</a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" class={shareClass}><Icon name="fa-facebook-f" />Facebook</a>
        <button id="copy-link" type="button" data-url={pageUrl} data-done={t('share.copied', lang)} class={shareClass}><Icon name="fa-link" /><span>{t('share.copy', lang)}</span></button>
      </div>

      <!-- Neighbouring events -->
      {neighbours.length > 0 && (
        <div class="grid sm:grid-cols-2 gap-4 mb-16">
          {neighbours.map(({ev, label, icon, side, align}) => (
            <a href={localePath(lang, `/events/${ev.slug}/`)} class={`card-hover flex items-center gap-4 bg-white border border-gray-100 rounded-2xl p-4 ${side}`}>
              <img src={eventCover(ev, 160, 160)} alt="" width="80" height="80" loading="lazy" class="w-20 h-20 rounded-xl object-cover bg-gray-100 shrink-0" />
              <span class="min-w-0">
                <span class={`flex items-center gap-2 text-xs font-semibold text-jci-blue-ink mb-1 ${align}`}>
                  <Icon name={icon} class="rtl:rotate-180" />{label}
                </span>
                <span class="block font-semibold text-jci-black truncate">{pick(ev.title, lang)}</span>
              </span>
            </a>
          ))}
        </div>
      )}

      <!-- Join -->
      <div class="text-center bg-gradient-to-br from-jci-black via-jci-navy to-jci-blue rounded-3xl px-6 py-12">
        <p class="text-2xl font-light text-white mb-6">{t('event.cta', lang)}</p>
        <a href={`${localePath(lang, '/')}#join`} class="inline-block bg-white text-jci-navy hover:bg-jci-teal hover:text-jci-black px-8 py-3.5 rounded-full font-semibold transition-colors">{t('nav.cta', lang)}</a>
      </div>
    </div>
  </main>
  <Footer settings={settings} lang={lang} />

  <!-- Lightbox -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label={pick(event.title, lang)} class="fixed inset-0 z-[60] bg-black/90 hidden items-center justify-center p-4 select-none">
    <button id="lightbox-close" aria-label={t('a11y.close', lang)} class="absolute top-5 end-5 w-11 h-11 flex items-center justify-center rounded-full text-white/80 hover:text-white hover:bg-white/10 text-2xl"><Icon name="fa-times" /></button>
    <button id="lightbox-prev" aria-label={t('a11y.prev', lang)} class="absolute start-2 sm:start-5 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-black/50 hover:bg-black/70 text-white text-lg"><Icon name="fa-chevron-left" class="rtl:rotate-180" /></button>
    <button id="lightbox-next" aria-label={t('a11y.next', lang)} class="absolute end-2 sm:end-5 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-black/50 hover:bg-black/70 text-white text-lg"><Icon name="fa-chevron-right" class="rtl:rotate-180" /></button>
    <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[85vh] rounded-lg object-contain" />
    <div id="lightbox-count" class="absolute bottom-5 left-1/2 -translate-x-1/2 text-white/70 text-sm tabular-nums" dir="ltr"></div>
  </div>

  <SiteScripts />

  <script is:inline>
    (function () {
      const copy = document.getElementById('copy-link')
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copy.dataset.url)
          copy.querySelector('span').textContent = copy.dataset.done
        } catch (e) {
          prompt('', copy.dataset.url)
        }
      })
    })()
  </script>

  <script is:inline>
    (function () {
      const lb = document.getElementById('lightbox')
      const lbImg = document.getElementById('lightbox-img')
      const count = document.getElementById('lightbox-count')
      const closeBtn = document.getElementById('lightbox-close')
      const prevBtn = document.getElementById('lightbox-prev')
      const nextBtn = document.getElementById('lightbox-next')
      const items = [...document.querySelectorAll('.gallery-item')]
      if (!items.length) return
      const srcs = items.map((b) => b.getAttribute('data-full'))
      const single = srcs.length < 2
      prevBtn.hidden = nextBtn.hidden = single
      let current = 0
      let opener = null

      function show(i) {
        current = (i + srcs.length) % srcs.length
        lbImg.src = srcs[current]
        lbImg.alt = items[current].querySelector('img')?.alt || ''
        count.textContent = single ? '' : current + 1 + ' / ' + srcs.length
        // Warm the cache for the neighbours so prev/next feel instant
        ;[current - 1, current + 1].forEach((n) => { new Image().src = srcs[(n + srcs.length) % srcs.length] })
      }
      function open(i, from) {
        opener = from
        show(i)
        lb.classList.remove('hidden'); lb.classList.add('flex')
        document.body.style.overflow = 'hidden'
        closeBtn.focus()
      }
      function hide() {
        if (lb.classList.contains('hidden')) return
        lb.classList.add('hidden'); lb.classList.remove('flex'); lbImg.src = ''
        document.body.style.overflow = ''
        opener?.focus()
      }
      const isOpen = () => !lb.classList.contains('hidden')
      const rtl = () => document.documentElement.dir === 'rtl'

      items.forEach((b, i) => b.addEventListener('click', () => open(i, b)))
      closeBtn.addEventListener('click', hide)
      prevBtn.addEventListener('click', () => show(current - 1))
      nextBtn.addEventListener('click', () => show(current + 1))
      lb.addEventListener('click', (e) => { if (e.target === lb) hide() })
      document.addEventListener('keydown', (e) => {
        if (!isOpen()) return
        if (e.key === 'Escape') hide()
        // Arrow keys follow reading direction (left = next in Arabic)
        else if (e.key === 'ArrowRight') show(current + (rtl() ? -1 : 1))
        else if (e.key === 'ArrowLeft') show(current + (rtl() ? 1 : -1))
        else if (e.key === 'Tab') {
          // Keep keyboard focus inside the dialog
          const f = [closeBtn, prevBtn, nextBtn].filter((el) => !el.hidden)
          const idx = f.indexOf(document.activeElement)
          e.preventDefault()
          f[(idx + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus()
        }
      })

      // Swipe on touch screens
      let x0 = null
      lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX }, {passive: true})
      lb.addEventListener('touchend', (e) => {
        if (x0 === null || single) return
        const dx = e.changedTouches[0].clientX - x0
        x0 = null
        if (Math.abs(dx) < 50) return
        const forward = dx < 0 !== rtl()
        show(current + (forward ? 1 : -1))
      })
    })()
  </script>
</Base>
