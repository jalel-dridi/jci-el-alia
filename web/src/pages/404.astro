---
/**
 * 404 page — on-brand, with a route back home. Cloudflare Pages serves this one
 * file for unknown paths in every language, so a small script switches it to
 * the language in the address (or the visitor's saved choice).
 */
import Base from '../layouts/Base.astro'
import {t, localePath, dirFor} from '../i18n/utils.js'
import {languages} from '../i18n/ui.js'

const strings = Object.fromEntries(languages.map((l) => [l, {
  title: t('nf.title', l), desc: t('nf.desc', l), back: t('nf.back', l), home: localePath(l, '/'), dir: dirFor(l),
}]))
---

<Base title={`${t('nf.title', 'en')} | JCI El Alia`}>
  <main class="min-h-svh flex items-center justify-center bg-gradient-to-br from-jci-black via-jci-navy to-jci-blue px-6">
    <div class="text-center">
      <p class="text-jci-teal font-semibold uppercase tracking-widest mb-4">404</p>
      <h1 id="nf-title" class="text-4xl sm:text-5xl font-light text-white mb-4">{t('nf.title', 'en')}</h1>
      <p id="nf-desc" class="text-white/80 max-w-md mx-auto mb-8">{t('nf.desc', 'en')}</p>
      <a id="nf-back" href="/" class="inline-block bg-white text-jci-navy hover:bg-jci-teal hover:text-jci-black px-8 py-4 rounded-full font-semibold transition-colors">{t('nf.back', 'en')}</a>
    </div>
  </main>
  <script is:inline define:vars={{strings}}>
    let saved = null
    try { saved = localStorage.getItem('jci-lang') } catch (e) {}
    const lang = location.pathname.match(/^\/(fr|ar)(\/|$)/)?.[1] || saved
    const s = strings[lang]
    if (s) {
      document.documentElement.lang = lang
      document.documentElement.dir = s.dir
      document.title = s.title + ' | JCI El Alia'
      document.getElementById('nf-title').textContent = s.title
      document.getElementById('nf-desc').textContent = s.desc
      const back = document.getElementById('nf-back')
      back.textContent = s.back
      back.href = s.home
    }
  </script>
</Base>
