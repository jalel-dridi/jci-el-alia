---
/**
 * Base layout — <head>, fonts, global CSS, full SEO, and the page shell.
 * `lang` sets language + direction. `path` is the page's language-free path
 * ("/events/"); when given, hreflang alternates for EN/FR/AR are emitted and
 * returning visitors who picked FR/AR are sent to their language.
 */
import '../styles/global.css'
import {t, dirFor, localePath} from '../i18n/utils.js'
import {languages} from '../i18n/ui.js'

const {lang = 'en', path, image = '/images/logo.png'} = Astro.props
const {title = t('meta.title', lang), description = t('meta.desc', lang)} = Astro.props
const dir = dirFor(lang)

// Canonical + absolute OG image URL (falls back gracefully if `site` unset)
const base = Astro.site ?? 'https://jci-el-alia.pages.dev'
const canonical = new URL(Astro.url.pathname, base).href
const ogImage = new URL(image, base).href
const alternates = path ? languages.map((l) => ({l, href: new URL(localePath(l, path), base).href})) : []

// Organization structured data for richer search results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'JCI El Alia',
  alternateName: 'Jeune Chambre Internationale El Alia',
  url: Astro.site?.href ?? 'https://jci-el-alia.pages.dev',
  logo: ogImage,
  foundingDate: '1989',
  email: 'jcielalia@gmail.com',
  telephone: '+216 20 382 274',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Avenue Habib Bourguiba',
    addressLocality: 'El Alia',
    postalCode: '7016',
    addressRegion: 'Bizerte',
    addressCountry: 'TN',
  },
  sameAs: [
    'https://www.facebook.com/jcielalia',
    'https://www.linkedin.com/in/jci-el-alia',
  ],
}
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    {path && lang === 'en' && (
      <!-- Returning visitors who chose FR/AR (saved by the language switcher)
           go straight to their language, before anything renders. -->
      <script is:inline>
        try {
          var l = localStorage.getItem('jci-lang')
          if (l === 'fr' || l === 'ar') location.replace('/' + l + location.pathname + location.search + location.hash)
        } catch (e) {}
      </script>
    )}
    <!-- Turn on entrance animations (src/scripts/motion.js) unless the visitor
         prefers reduced motion, plus the branded intro screen on the first
         page of a visit. If the script hasn't run within 4s, drop both classes
         so nothing stays hidden. Going back through history plays the page
         transition in reverse (see ::view-transition rules in global.css). -->
    <script is:inline>
      try {
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          var root = document.documentElement
          root.classList.add('motion')
          try { if (!sessionStorage.getItem('jci-intro')) root.classList.add('intro') } catch (e) {}
          setTimeout(function () { if (!window.__motionReady) root.classList.remove('motion', 'intro') }, 4000)
          setTimeout(function () { root.classList.remove('intro') }, 7000)
          addEventListener('pagereveal', function (e) {
            var a = window.navigation && navigation.activation
            if (e.viewTransition && a && a.navigationType === 'traverse' && a.from && a.entry && a.entry.index < a.from.index) {
              e.viewTransition.types.add('back')
            }
          })
        }
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0097D7" />
    <link rel="canonical" href={canonical} />
    {alternates.map(({l, href}) => <link rel="alternate" hreflang={l} href={href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="JCI El Alia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : lang === 'ar' ? 'ar_TN' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Noto+Sans+Arabic:wght@300;400;500;600;700&family=Arvo:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="bg-white text-jci-black antialiased">
    <!-- Intro screen, first page of a visit only (html.intro); lifted by motion.js -->
    <div id="intro" aria-hidden="true">
      <img src="/images/logo-intro.png" alt="" width="260" height="121" data-intro-logo />
      <div class="intro-track"><div data-intro-bar></div></div>
    </div>
    <a href="#home" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-jci-blue focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
      {t('a11y.skip', lang)}
    </a>
    <slot />
    <script>
      import '../scripts/motion.js'
    </script>
  </body>
</html>
